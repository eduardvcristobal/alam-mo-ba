# Leave disabled until Google provider integration, privacy/guardian controls,
# abuse testing and formal M1.2 acceptance are complete.
VITE_ACCOUNT_SIGNIN_ENABLED=false
# Public Google OAuth Web Client ID (not a secret). Must match GOOGLE_CLIENT_ID
# configured on the backend and the exact authorized JavaScript origin.
VITE_GOOGLE_CLIENT_ID=
# Optional API path override; the Vite proxy defaults to /api/v1.
VITE_API_BASE_URL=/api/v1
