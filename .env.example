# Local development settings. Docker Compose reads the POSTGRES_* values
# when creating the PostgreSQL container. Keep these in sync with DB_* below.
# These sample credentials are only for local development; use secure secrets
# if you deploy this app anywhere public.
# Database name created inside PostgreSQL.
POSTGRES_DB=alammoba
# PostgreSQL login used by the app and the local container.
POSTGRES_USER=alammoba
# Password for POSTGRES_USER (and DB_PASSWORD below).
POSTGRES_PASSWORD=alammoba_dev
# Backend connection string: jdbc:postgresql://host:port/database.
# With the default Docker Compose setup, localhost:5432/alammoba is correct.
DB_URL=jdbc:postgresql://localhost:5432/alammoba
# Backend database login; should match POSTGRES_USER above.
DB_USER=alammoba
# Backend database password; should match POSTGRES_PASSWORD above.
DB_PASSWORD=alammoba_dev
# Port the Spring Boot backend listens on (run.sh defaults to 8080).
PORT=8080
